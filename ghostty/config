# ============================================================================
#  Ghostty config — custom dark theme, matched to the zsh prompt palette
#  Reload in-app with Cmd+Shift+, (some keys need a full restart)
#  Docs: https://ghostty.org/docs/config
#  Machine-specific overrides: ~/.config/ghostty/config.local (see bottom)
# ============================================================================

# ------------------------------------
# Font — Ghostty's bundled JetBrains Mono (includes Nerd Font symbols, so the
# prompt's  glyph renders out of the box). Set a font-family in config.local
# to use a machine-installed font instead.
# ------------------------------------
font-size = 14
# Slightly looser lines read better for long agent/log output
adjust-cell-height = 8%

# ------------------------------------
# Colors — custom dark palette
#   bg #121113 · fg #ffffff · teal #5f8787 · peach #fbcb97 · orange #e78a53
# ------------------------------------
background = #121113
foreground = #ffffff
cursor-color = #fbcb97
cursor-text = #121113
selection-background = #2b2b2b
selection-foreground = #ffffff

# 16-color ANSI palette (warm/muted, harmonized with the syntax theme)
palette = 0=#39383a
palette = 1=#e06c5d
palette = 2=#8a9a5b
palette = 3=#fbcb97
palette = 4=#6a8fb5
palette = 5=#9a7ecc
palette = 6=#5f8787
palette = 7=#c1c1c1
palette = 8=#888888
palette = 9=#e78a53
palette = 10=#a3b08a
palette = 11=#ffd9a8
palette = 12=#82a8d0
palette = 13=#b29ad8
palette = 14=#7faaaa
palette = 15=#ffffff

# ------------------------------------
# Window / padding
# ------------------------------------
window-padding-x = 12
window-padding-y = 12
window-padding-balance = true

# ------------------------------------
# Cursor / input quality-of-life
# ------------------------------------
cursor-style = block
cursor-style-blink = false
mouse-hide-while-typing = true
# Treat macOS Option as Alt so zsh word-motions and fzf's Alt-C (cd) work
macos-option-as-alt = true

# ------------------------------------
# Quick terminal — Ctrl+` drops a terminal from the top
# ------------------------------------
keybind = global:ctrl+`=toggle_quick_terminal
quick-terminal-animation-duration = 0.1
quick-terminal-position = top
# Dashboard mode: the visor stays visible when it loses focus; Ctrl+` dismisses
quick-terminal-autohide = false

# ------------------------------------
# SSH — carry our terminfo to remote hosts
# ------------------------------------
# Ghostty ships xterm-ghostty inside the app bundle and points shells at it via
# $TERMINFO. sshd-spawned shells never inherit that var, so without this an
# inbound session lands on a $TERM the remote can't resolve and ZLE smears every
# keystroke. ssh-terminfo installs the entry into the remote's ~/.terminfo on
# first connect; ssh-env sets a sane $TERM where that isn't possible.
# This key MERGES into the defaults (cursor,no-sudo,title,no-ssh-env,
# no-ssh-terminfo,path) rather than replacing them: naming these two flips only
# them, so the other four keep tracking upstream instead of being pinned here.
shell-integration-features = ssh-env,ssh-terminfo

# ------------------------------------
# Amber phosphor layer — the base palette warm-shifted toward a CRT amber,
# plus the scanline shader. Applies to ALL windows (Ghostty has no per-window
# theming); comment this line out to return to the stock palette above.
# ------------------------------------
config-file = ?~/.config/ghostty/config.retro

# ------------------------------------
# Machine-specific config (not tracked) — kept last so it overrides anything
# above. The '?' makes it optional: no error if the file doesn't exist.
# ------------------------------------
config-file = ?~/.config/ghostty/config.local
